{% extends 'base.html.twig' %}

{% block title %}Connexion - Heritage Motors{% endblock %}

{% block body %}
<div class="dark-theme-wrapper login-page">
    <div class="login-container">
        <div class="login-header">
            <img src="{{ asset('images/logo.png') }}" alt="Heritage Motors" class="login-logo">
            <h1 class="login-title">Connexion</h1>
            <p class="login-subtitle">Accédez à votre espace privilège</p>
        </div>

        <form method="post">
            {% if error %}
                <div class="login-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="login-info">
                    Vous êtes déjà connecté en tant que <span class="gold-text">{{ app.user.userIdentifier }}</span>,
                    <a href="{{ path('app_logout') }}">Me déconnecter</a>
                </div>
            {% endif %}

            <div class="form-group">
                <label for="inputEmail">Email</label>
                <input type="email" 
                       value="{{ last_username }}" 
                       name="email" 
                       id="inputEmail" 
                       class="form-input" 
                       autocomplete="email" 
                       required autofocus 
                       placeholder="exemple@email.com">
            </div>

            <div class="form-group">
                <label for="inputPassword">Mot de passe</label>
                <input type="password" 
                       name="password" 
                       id="inputPassword" 
                       class="form-input" 
                       autocomplete="current-password" 
                       required 
                       placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group checkbox-container">
                <label>
                    <input type="checkbox" name="_remember_me"> Se souvenir de moi
                </label>
            </div>

            <button class="btn-gold-full" type="submit">
                Se connecter
            </button>

            <div class="login-links" style="justify-content: center; margin-top: 20px; display: flex;">
                <span style="color: #666;">Vous n'avez pas de compte ?</span>
                <a href="{{ path('app_register') }}" style="margin-left: 5px;">S'inscrire</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}