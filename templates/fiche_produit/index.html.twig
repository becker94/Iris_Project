{% extends 'base.html.twig' %}

{% block title %}{{ vehicule.titre }} - Heritage Motors{% endblock %}

{% block body %}
<div class="product-wrapper">
    <div class="product-container">
        
        <div class="product-visual">
            <span class="product-badge">{{ vehicule.badge }}</span>
            <img src="{{ asset('images/' ~ vehicule.image) }}" alt="{{ vehicule.titre }}" class="main-img">
        </div>

        <div class="product-info">
            <div class="product-header">
                <h1 class="product-title">{{ vehicule.titre }}</h1>
                <p class="product-subtitle">{{ vehicule.sous_titre }}</p>
            </div>

            <div class="product-price-box">
                <span class="label">Prix journée</span>
                <span class="price">{{ vehicule.prix }}</span>
            </div>

            <div class="specs-grid">
                <div class="spec-item">
                    <span class="spec-icon">📅</span>
                    <span class="spec-label">Année</span>
                    <span class="spec-value">{{ vehicule.annee }}</span>
                </div>
                <div class="spec-item">
                    <span class="spec-icon">🐎</span>
                    <span class="spec-label">Puissance</span>
                    <span class="spec-value">{{ vehicule.puissance }}</span>
                </div>
                <div class="spec-item">
                    <span class="spec-icon">⏱️</span>
                    <span class="spec-label">0-100 km/h</span>
                    <span class="spec-value">{{ vehicule.acceleration }}</span>
                </div>
                <div class="spec-item">
                    <span class="spec-icon">⛽</span>
                    <span class="spec-label">Carburant</span>
                    <span class="spec-value">{{ vehicule.carburant }}</span>
                </div>
            </div>

            <div class="product-description">
                <p>{{ vehicule.description }}</p>
            </div>

            <div class="product-actions">
                <button class="btn-gold-large">Réserver ce véhicule</button>
                <button class="btn-outline">Contacter un expert</button>
            </div>
        </div>

    </div>
</div>
{% endblock %}