{% extends 'base.html.twig' %}

{% block title %}Paiement confirmé — Heritage Motors{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-72px)] flex items-center justify-center px-6 py-16">
    <div class="text-center max-w-md animate-fadeup">

        {# Icon #}
        <div class="w-24 h-24 border border-gold/30 bg-gold/5 rounded-full
                    flex items-center justify-center mx-auto mb-10">
            <svg viewBox="0 0 24 24" width="40" height="40" stroke="#c9a96e" stroke-width="1.5" fill="none">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <p class="text-[10px] tracking-[5px] uppercase text-gold mb-4">Transaction réussie</p>
        <h1 class="font-serif text-4xl md:text-5xl font-light tracking-[4px] uppercase mb-4">
            Paiement confirmé
        </h1>
        <p class="font-serif italic text-gold text-lg mb-8">Merci pour votre acquisition</p>

        <p class="text-[#555] text-sm leading-relaxed mb-12">
            Votre transaction a été traitée avec succès.<br>
            Un email de confirmation vous sera envoyé dans les prochaines minutes.
        </p>

        <a href="{{ path('app_accueil') }}"
           class="inline-block bg-gold hover:bg-gold-light text-black font-semibold
                  text-[10px] tracking-[4px] uppercase px-12 py-4
                  transition-all duration-300 hover:-translate-y-0.5">
            Retour à l'accueil
        </a>

    </div>
</div>
{% endblock %}
