{% extends 'base.html.twig' %}

{% block title %}Paiement — Heritage Motors{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 lg:px-10 py-16">

    {# Breadcrumb #}
    <a href="{{ path('app_voiture_show', {'id': voiture.id_voiture}) }}"
       class="text-[10px] tracking-[3px] uppercase text-[#555] hover:text-gold transition-colors inline-flex items-center gap-2 mb-12">
        ← Retour à la fiche
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">

        {# ── Left: Order summary ── #}
        <aside class="lg:col-span-2 bg-surface border border-white/5 p-8 lg:sticky lg:top-24">
            <p class="text-[9px] tracking-[4px] uppercase text-gold mb-6">Récapitulatif</p>

            {# Car image #}
            <div class="overflow-hidden mb-6 aspect-video">
                <img src="{{ voiture.image ? (voiture.image starts with 'http' ? voiture.image : asset('images/' ~ voiture.image)) : 'https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=800&q=80' }}"
                     alt="{{ voiture.immatriculation }}"
                     class="w-full h-full object-cover">
            </div>

            <h2 class="font-serif text-2xl font-light mb-1">{{ voiture.immatriculation }}</h2>
            <p class="text-[11px] text-[#555] tracking-wider mb-6">
                {{ voiture.annee_mise_en_service }} · {{ voiture.kilometrage|number_format(0, ',', ' ') }} km
            </p>

            <div class="border-t border-white/5 pt-6 flex items-center justify-between">
                <span class="text-[10px] tracking-[3px] uppercase text-[#555]">Total</span>
                <span class="font-serif text-3xl text-gold">
                    {{ voiture.prix_achat|number_format(0, '.', ' ') }} €
                </span>
            </div>
        </aside>

        {# ── Right: Payment form ── #}
        <div class="lg:col-span-3 animate-fadeup">
            <p class="text-[9px] tracking-[4px] uppercase text-gold mb-8">Informations de paiement</p>

            <form method="POST"
                  action="{{ path('app_fake_payment_submit', {'id': voiture.id_voiture}) }}"
                  class="flex flex-col gap-6">

                {% set inputClass = 'w-full bg-[#0d0d0d] border border-white/10 focus:border-gold text-[#f0f0f0] placeholder-[#2a2a2a] text-sm px-4 py-3.5 outline-none transition-colors duration-300' %}
                {% set labelClass = 'text-[10px] tracking-[3px] uppercase text-gold font-semibold mb-2 block' %}

                {# Card number #}
                <div>
                    <label for="card_number" class="{{ labelClass }}">Numéro de carte</label>
                    <input type="text" id="card_number" name="card_number"
                           placeholder="4242 4242 4242 4242" maxlength="19" autocomplete="off"
                           class="{{ inputClass }}">
                </div>

                {# Expiry + CVV #}
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="expiry" class="{{ labelClass }}">Expiration</label>
                        <input type="text" id="expiry" name="expiry"
                               placeholder="MM / AA" maxlength="7" autocomplete="off"
                               class="{{ inputClass }}">
                    </div>
                    <div>
                        <label for="cvv" class="{{ labelClass }}">CVV</label>
                        <input type="text" id="cvv" name="cvv"
                               placeholder="123" maxlength="3" autocomplete="off"
                               class="{{ inputClass }}">
                    </div>
                </div>

                {# Card name #}
                <div>
                    <label for="card_name" class="{{ labelClass }}">Nom sur la carte</label>
                    <input type="text" id="card_name" name="card_name"
                           placeholder="Jean Dupont" autocomplete="off"
                           class="{{ inputClass }}">
                </div>

                {# Security notice #}
                <div class="flex items-center gap-3 text-[#444] text-[11px] tracking-wider
                            border border-white/5 px-4 py-3 bg-surface">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" class="flex-shrink-0">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Simulation paiement — Démo scolaire
                </div>

                {# Submit #}
                <button type="submit"
                        class="w-full bg-gold hover:bg-gold-light text-black font-semibold
                               text-[10px] tracking-[4px] uppercase py-5 mt-2
                               transition-all duration-300 hover:-translate-y-0.5">
                    Payer {{ voiture.prix_achat|number_format(0, '.', ' ') }} €
                </button>

                <a href="{{ path('app_voiture_show', {'id': voiture.id_voiture}) }}"
                   class="block text-center border border-white/10 text-[#555] hover:border-gold/30 hover:text-gold
                          text-[10px] tracking-[3px] uppercase py-4 transition-all duration-300">
                    Annuler
                </a>

            </form>
        </div>
    </div>
</div>
{% endblock %}
