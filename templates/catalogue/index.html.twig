{% extends 'base.html.twig' %}

{% block title %}Notre Collection — Heritage Motors{% endblock %}

{% block body %}

    {# ══ ALERTE DIRECTUS HORS-LIGNE ══════════════════════════════════════════ #}
    {% if error is defined and error %}
        <div id="directus-error"
             class="bg-red-950/40 border border-red-800/40 text-red-400 text-sm
                    px-6 py-4 max-w-7xl mx-auto mt-6">
            {{ error }}
        </div>
    {% endif %}

    {# ══ HEADER BANNER ══════════════════════════════════════════════════════ #}
    <div class="relative h-56 flex items-center justify-center overflow-hidden">
        <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=1920&q=80"
             alt="Collection Heritage"
             class="absolute inset-0 w-full h-full object-cover opacity-20">
        <div class="absolute inset-0 bg-gradient-to-b from-[#080808]/50 to-[#080808]"></div>
        <div class="relative z-10 text-center">
            <p class="text-[10px] tracking-[5px] uppercase text-gold mb-4">Heritage Motors</p>
            <h1 class="font-serif text-5xl md:text-6xl font-light tracking-[8px] uppercase">
                La <span class="text-gold">Collection</span>
            </h1>
        </div>
    </div>

    {# ══ GRID ════════════════════════════════════════════════════════════════ #}
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16">

        {# Compteur #}
        {% if voitures|length > 0 %}
            <p class="text-[10px] tracking-[3px] uppercase text-[#444] mb-10">
                {{ voitures|length }} véhicule{{ voitures|length > 1 ? 's' : '' }} disponible{{ voitures|length > 1 ? 's' : '' }}
            </p>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for voiture in voitures %}

                <article class="group bg-surface border border-white/5 hover:border-gold/30
                                transition-all duration-500 hover:-translate-y-2
                                hover:shadow-[0_30px_60px_rgba(0,0,0,0.6)]">

                    {# Image #}
                    <div class="overflow-hidden h-60 relative">
                        <span class="absolute top-4 left-4 z-10 bg-gold text-black
                                     text-[9px] tracking-[2px] uppercase px-3 py-1 font-semibold">
                            Disponible
                        </span>
                        <img src="{{ voiture.image ? (voiture.image starts with 'http' ? voiture.image : asset('images/' ~ voiture.image)) : 'https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=800&q=80' }}"
                             alt="{{ voiture.immatriculation }}"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>

                    {# Details #}
                    <div class="p-7">
                        <p class="text-[9px] tracking-[3px] uppercase text-gold mb-2">Premium Heritage</p>
                        <h3 class="font-serif text-2xl font-light mb-5">{{ voiture.immatriculation }}</h3>

                        <div class="flex gap-6 text-[11px] text-[#555] tracking-wider
                                    border-t border-b border-white/5 py-4 mb-5">
                            <span>{{ voiture.annee_mise_en_service }}</span>
                            <span>{{ voiture.kilometrage|number_format(0, ',', ' ') }} km</span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="font-serif text-2xl text-gold">
                                {{ voiture.prix_achat|number_format(0, '.', ' ') }} €
                            </span>
                            <a href="{{ path('app_voiture_show', {'id': voiture.id_voiture}) }}"
                               class="text-[9px] tracking-[3px] uppercase border border-gold/40 text-gold
                                      hover:bg-gold hover:text-black px-5 py-2.5 transition-all duration-300">
                                Voir →
                            </a>
                        </div>
                    </div>
                </article>

            {% else %}
                <div class="col-span-3 text-center py-32 text-[#444]">
                    <p class="font-serif text-3xl font-light">Aucun véhicule disponible pour le moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
