{% extends 'base.html.twig' %}

{% block title %}Catalogue - Heritage Motors{% endblock %}

{% block body %}
<style>
    body {
        background-color: #000;
        color: #fff;
        font-family: Arial, sans-serif;
    }

    .catalogue-header {
        text-align: center;
        padding: 60px 20px 40px;
        background: linear-gradient(135deg, #1a1a1a 0%, #000 100%);
    }

    .catalogue-header h1 span { color: #d4af37; }

    .vehicules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
        padding: 40px 50px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .vehicule-card {
        background: linear-gradient(145deg, #1a1a1a, #0d0d0d);
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #333;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .vehicule-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(212, 175, 55, 0.3);
        border-color: #d4af37;
    }

    .vehicule-image {
        width: 100%;
        height: 250px;
        position: relative;
        overflow: hidden;
    }

    .vehicule-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .badge-disponible {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #d4af37;
        color: #000;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        z-index: 2;
    }

    .badge-loue { background: #666; color: #fff; }

    .vehicule-details { padding: 25px; }

    .vehicule-title { font-size: 1.5rem; font-weight: bold; color: #d4af37; margin-bottom:5px; }

    .vehicule-marque { color: #999; font-size: 0.95rem; margin-bottom:15px; }

    .vehicule-footer { display: flex; justify-content: space-between; padding-top: 15px; border-top: 1px solid #333; }

    .vehicule-prix { font-size: 1.8rem; font-weight: bold; color: #d4af37; }
    .vehicule-annee { color: #888; font-size: 0.9rem; }

    .btn-details { background: linear-gradient(135deg, #d4af37, #f4d03f); color:#000; padding:10px 25px; border-radius:25px; font-weight:bold; text-decoration:none; }
    .btn-details:hover { transform: scale(1.05); box-shadow: 0 5px 20px rgba(212,175,55,0.5);}
</style>

<div class="catalogue-header">
    <h1>CATALOGUE <span>MOTORS</span></h1>
    <p>Découvrez notre collection exclusive de véhicules d'exception</p>
</div>

<div class="vehicules-grid">
    <div class="vehicule-card">
        <div class="vehicule-image">
            <img src="{{ asset('images/huracan.png') }}" alt="Huracan">
            <span class="badge-disponible">DISPONIBLE</span>
        </div>
        <div class="vehicule-details">
            <div class="vehicule-title">Huracan</div>
            <div class="vehicule-marque">Lamborghini</div>
            <div class="vehicule-footer">
                <div>
                    <div class="vehicule-prix">250 000 €</div>
                    <div class="vehicule-annee">2021</div>
                </div>
                <a href="#" class="btn-details">Détails</a>
            </div>
        </div>
    </div>

    <div class="vehicule-card">
        <div class="vehicule-image">
                            <img src="{{ asset('images/gtb.png') }}" alt="GTB" class="contain-img">
            <span class="badge-disponible">DISPONIBLE</span>
        </div>
        <div class="vehicule-details">
            <div class="vehicule-title">GTB</div>
            <div class="vehicule-marque">Ferrari</div>
            <div class="vehicule-footer">
                <div>
                    <div class="vehicule-prix">300 000 €</div>
                    <div class="vehicule-annee">2020</div>
                </div>
                <a href="#" class="btn-details">Détails</a>
            </div>
        </div>
    </div>

    <div class="vehicule-card">
        <div class="vehicule-image">
            <img src="{{ asset('images/carrera.png') }}" alt="Carrera">
            <span class="badge-disponible badge-loue">LOUÉ</span>
        </div>
        <div class="vehicule-details">
            <div class="vehicule-title">Carrera</div>
            <div class="vehicule-marque">Porsche</div>
            <div class="vehicule-footer">
                <div>
                    <div class="vehicule-prix">150 000 €</div>
                    <div class="vehicule-annee">2019</div>
                </div>
                <a href="#" class="btn-details">Détails</a>
            </div>
        </div>
    </div>
</div>

{% endblock %}
