{% extends 'base.html.twig' %}

{% block title %}Catalogue - Heritage Motors{% endblock %}

{% block body %}
<div class="catalogue-wrapper">
    
    <aside class="catalogue-sidebar">
        <div class="sidebar-header">
            <h3>Filtrer par</h3>
        </div>
        
        <ul class="sidebar-menu">
            <li class="active">
                <span class="icon">🏎️</span> Toute la collection
            </li>
            <li>
                <span class="icon">💎</span> Hypercars
            </li>
            <li>
                <span class="icon">✨</span> Classiques
            </li>
            <li>
                <span class="icon">⚡</span> Électriques
            </li>
            <li>
                <span class="icon">🚙</span> SUV Luxe
            </li>
        </ul>

        <div class="sidebar-promo">
            <p>Besoin d'un conseil ?</p>
            <a href="#" class="btn-gold-small">Nous contacter</a>
        </div>
    </aside>

    <main class="catalogue-main">
        
        <div class="catalogue-topbar">
            <div class="topbar-title">
                <h1>Notre <span class="gold-text">Catalogue</span></h1>
            </div>
        </div>

        <div class="cars-grid">
            
            <div class="car-card">
                <div class="card-image">
                    <span class="badge available">Disponible</span>
                    <img src="{{ asset('images/ferrari_f40.png') }}" alt="Ferrari F40">
                </div>
                <div class="card-details">
                    <div class="card-header">
                        <h3>Ferrari F40</h3>
                        <span class="category">Supercar</span>
                    </div>
                    <div class="card-specs">
                        <span>📅 1992</span>
                        <span>🐎 478 ch</span>
                        <span>⛽ Essence</span>
                    </div>
                    <div class="card-footer">
                        <div class="price">1 200 000 €</div>
                        <a href="{{ path('app_fiche_produit', {'id': 1}) }}" class="btn-icon">➜</a>
                    </div>
                </div>
            </div>

            <div class="car-card">
                <div class="card-image">
                    <span class="badge reserved">Réservé</span>
                    <img src="{{ asset('images/shelby_1.jpg') }}" alt="Shelby GT500">
                </div>
                <div class="card-details">
                    <div class="card-header">
                        <h3>Shelby GT 500</h3>
                        <span class="category">Muscle Car</span>
                    </div>
                    <div class="card-specs">
                        <span>📅 1967</span>
                        <span>🐎 355 ch</span>
                        <span>⛽ Essence</span>
                    </div>
                    <div class="card-footer">
                        <div class="price">289 000 €</div>
                        <a href="{{ path('app_fiche_produit', {'id': 2}) }}" class="btn-icon">➜</a>
                    </div>
                </div>
            </div>

            <div class="car-card">
                <div class="card-image">
                    <span class="badge available">Disponible</span>
                    <img src="{{ asset('images/bentley_1.jpg') }}" alt="Bentley">
                </div>
                <div class="card-details">
                    <div class="card-header">
                        <h3>Bentley Continental</h3>
                        <span class="category">Luxe</span>
                    </div>
                    <div class="card-specs">
                        <span>📅 2022</span>
                        <span>🐎 650 ch</span>
                        <span>⛽ Hybride</span>
                    </div>
                    <div class="card-footer">
                        <div class="price">320 000 €</div>
                        <a href="{{ path('app_fiche_produit', {'id': 3}) }}" class="btn-icon">➜</a>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>
{% endblock %}