{% extends 'base.html.twig' %}

{% block title %}Inscription - Heritage Motors{% endblock %}

{% block body %}
<div class="dark-theme-wrapper login-page">
    <div class="login-container">
        
        <div class="login-header">
            <img src="{{ asset('images/logo.png') }}" alt="Heritage Motors" class="login-logo">
            <h1 class="login-title">Inscription</h1>
            <p class="login-subtitle">Rejoignez le cercle Heritage Motors</p>
        </div>

        {{ form_start(registrationForm) }}
            
            {% if form_errors(registrationForm) %}
                <div class="login-error">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            <div class="form-group">
                <label>Email</label>
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'form-input',
                        'placeholder': 'exemple@email.com'
                    }
                }) }}
                <div style="color: #ff6b6b; font-size: 12px; margin-top: 5px;">
                    {{ form_errors(registrationForm.email) }}
                </div>
            </div>

            <div class="form-group">
                <label>Mot de passe</label>
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'form-input',
                        'placeholder': '••••••••'
                    }
                }) }}
                <div style="color: #ff6b6b; font-size: 12px; margin-top: 5px;">
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
            </div>

            <div class="form-group checkbox-container">
                {{ form_widget(registrationForm.agreeTerms) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}" style="display:inline; color:#aaa; font-weight:normal;">
                    J'accepte les conditions d'utilisation
                </label>
            </div>

            <button type="submit" class="btn-gold-full">
                S'inscrire
            </button>

            <div class="login-links" style="justify-content: center; margin-top: 20px;">
                <span style="color: #666;">Déjà membre ?</span>
                <a href="{{ path('app_login') }}" style="margin-left: 5px;">Se connecter</a>
            </div>

        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}