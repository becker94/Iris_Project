{% extends 'base.html.twig' %}

{% block title %}Inscription — Heritage Motors{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-72px)] flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-md animate-fadeup">

        <div class="bg-surface border border-white/5 p-10 shadow-[0_40px_100px_rgba(0,0,0,0.6)]">

            {# Header #}
            <div class="text-center mb-10">
                <img src="{{ asset('images/logo.png') }}" alt="Heritage Motors" class="h-10 w-auto mx-auto mb-7">
                <h1 class="font-serif text-3xl font-light tracking-[6px] uppercase mb-2">Inscription</h1>
                <p class="text-[11px] text-[#555] tracking-wider">Rejoignez le cercle Heritage Motors</p>
            </div>

            {# Errors #}
            {% if not registrationForm.vars.valid %}
                <div class="bg-red-950/40 border border-red-800/40 text-red-400 text-sm px-4 py-3 mb-7">
                    <ul class="space-y-1">
                        {% for error in registrationForm.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                        {% for child in registrationForm.children %}
                            {% for error in child.vars.errors %}
                                <li><strong>{{ child.vars.label|default(child.vars.name)|capitalize }} :</strong> {{ error.message }}</li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% set inputClass = 'w-full bg-[#0d0d0d] border border-white/10 focus:border-gold text-[#f0f0f0] placeholder-[#333] text-sm px-4 py-3.5 outline-none transition-colors duration-300' %}
            {% set labelClass = 'text-[10px] tracking-[3px] uppercase text-gold font-semibold' %}

            {{ form_start(registrationForm) }}

                {# Prénom + Nom #}
                <div class="grid grid-cols-2 gap-4 mb-5">
                    <div class="flex flex-col gap-2">
                        <label class="{{ labelClass }}">Prénom</label>
                        {{ form_widget(registrationForm.prenom, {'attr': {'class': inputClass, 'placeholder': 'Jean'}}) }}
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="{{ labelClass }}">Nom</label>
                        {{ form_widget(registrationForm.nom, {'attr': {'class': inputClass, 'placeholder': 'Dupont'}}) }}
                    </div>
                </div>

                {# Email #}
                <div class="flex flex-col gap-2 mb-5">
                    <label class="{{ labelClass }}">Email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': inputClass, 'placeholder': 'exemple@email.com'}}) }}
                </div>

                {# Password #}
                <div class="flex flex-col gap-2 mb-5">
                    <label class="{{ labelClass }}">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': inputClass, 'placeholder': '••••••••'}}) }}
                </div>

                {# Terms #}
                <label class="flex items-start gap-3 text-sm text-[#555] cursor-pointer mb-7">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'accent-gold w-4 h-4 mt-0.5 flex-shrink-0'}}) }}
                    <span>J'accepte les conditions d'utilisation</span>
                </label>

                {# Submit #}
                <button type="submit"
                        class="w-full bg-gold hover:bg-gold-light text-black font-semibold
                               text-[10px] tracking-[4px] uppercase py-4
                               transition-all duration-300 hover:-translate-y-0.5">
                    S'inscrire
                </button>

                {# Login link #}
                <p class="text-center text-sm text-[#444] mt-6">
                    Déjà membre ?
                    <a href="{{ path('app_login') }}"
                       class="text-gold hover:text-gold-light underline underline-offset-4 transition-colors ml-1">
                        Se connecter
                    </a>
                </p>

            {{ form_end(registrationForm) }}

        </div>
    </div>
</div>
{% endblock %}
