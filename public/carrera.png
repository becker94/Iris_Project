  background-color: #e8e8e8;
  color: rgb(0, 0, 0);
}
.header,
.headerSmall,
.footer,
.btn-primary,
.btn-primary:hover,
.btn-primary:focus,
.btn-primary:active {
  background-color: #010048;
}
.carOfTheWeek {
  border-bottom-color: #010048;
}
.carCard-label {
  color: rgb(0, 0, 0);
}
.carDetails-print {
  background-color: rgb(30, 31, 74);
}
.carDetails-title {
  color: rgb(30, 31, 74);
}
.contact-btn {
  background-color: rgb(30, 31, 74);
}
.contentBlock-title,
.sidebarBlock-title {
  color: #010048;
}
.contentBlock,
.sidebarBlock {
  background-color: rgb(255, 255, 255);
}
.dataList-label {
  color: rgb(153, 153, 153);
}
.quote-text {
  color: #909090;
}
h2 {
  color: #010048;
}
.search-icon,
.search-input,
.socialLink-icon {
  color: #010048;
}
